{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vault path access with parameter-bound lease cleanup",
  "type": "object",
  "required": [
    "type",
    "path",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "vault:path_access"
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/:-]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "read",
          "create",
          "update",
          "delete",
          "sudo",
          "list",
          "deny"
        ]
      }
    },
    "required_parameters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    }
  }
}
