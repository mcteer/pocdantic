# Copy to .env.local. Offline demo/validation needs none of these.
# Uncomment only the integrations you use; keep credentials out of Git.

# Model provider: select one matching key and install its extra.
# MODEL=google-gla:gemini-3.8-flash
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Other MODEL prefixes: openai:, openai-chat:, openai-responses:, anthropic:

# Portable browser baseline: see docs/setup.md for required provider/Vault preparation.
# DATABASE_AUTH_MODE=user-jwt
# OAUTH_PROVIDER=generic
# OAUTH_DISCOVERY_URL=
# OAUTH_ISSUER=
# OAUTH_AUDIENCE=
# OAUTH_ACCESS_TOKEN_TYP=at+jwt
# VAULT_JWT_AUTH_MOUNT=jwt
# VAULT_JWT_AUTH_ROLE=
# VAULT_DATABASE_MOUNT=database
# VAULT_DATABASE_ROLE=poc-readonly
# OAUTH_TRUSTED_HOSTS=[]
# OAUTH_CA_FILE=
# VAULT_CA_FILE=
# CLI reads need a private bearer token under either authentication route.
# BEARER_TOKEN=
# CLI portability denial check only (private token without database:read).
# PORTABILITY_DENIED_TOKEN=

# Advanced delegated-exchange route (compatibility default): agent OAuth client.
# VERIFY_TENANT_URL=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# Browser workspace: separate confidential login application.
# Register http://127.0.0.1:8000/auth/callback (match --port).
# LOGIN_CLIENT_ID=
# LOGIN_CLIENT_SECRET=
# LOGIN_SCOPES=openid offline_access database:read infra:write tickets:read

# Delegated database access (install postgres).
# VAULT_ADDR=
# VAULT_AUDIENCE=
# ACTOR_AUDIENCE=
# DATABASE_HOST=
# DATABASE_NAME=
# DATABASE_SSLROOTCERT=

# Phone approval: separate Verify API client and enrolled user/device.
# VERIFY_API_CLIENT_ID=
# VERIFY_API_CLIENT_SECRET=
# VERIFY_USER_ID=
# VERIFY_AUTHENTICATOR_ID=
# VERIFY_PUSH_ENABLED=true
# TIMEOUT_SECONDS=150

# Telemetry (install logfire).
# LOGFIRE_TOKEN=
# LOGFIRE_PROJECT=

# All optional overrides: docs/configuration.md

# Response enrollment uses .local/response/policy.json; no extra environment variables.
# Automatic exact cleanup is an explicit policy opt-in using the existing VAULT_TOKEN.
