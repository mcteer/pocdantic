# Local values only. Copy to .env.local; do not put credentials in Git.
POCDANTIC_MODEL=google-gla:gemini-3.8-flash
GOOGLE_API_KEY=
LOGFIRE_TOKEN=
VERIFY_TENANT_URL=
POCDANTIC_OAUTH_PROVIDER=verify
POCDANTIC_OAUTH_CLIENT_ID=
POCDANTIC_OAUTH_CLIENT_SECRET=
POCDANTIC_OAUTH_AUTH_METHOD=client_secret_post
POCDANTIC_OAUTH_DISCOVERY_URL=
POCDANTIC_OAUTH_ISSUER=
POCDANTIC_OAUTH_TOKEN_ENDPOINT=
POCDANTIC_OAUTH_AUDIENCE=
POCDANTIC_OAUTH_ACCESS_TOKEN_TYP=at+jwt
POCDANTIC_BEARER_TOKEN=
POCDANTIC_VERIFY_API_CLIENT_ID=
POCDANTIC_VERIFY_API_CLIENT_SECRET=
POCDANTIC_VERIFY_PUSH_ENABLED=false
POCDANTIC_VERIFY_AUTHENTICATOR_ID=
POCDANTIC_VERIFY_USER_ID=
POCDANTIC_TIMEOUT_SECONDS=45
POCDANTIC_PROFILES_FILE=config/agents.json
POCDANTIC_WORKLOAD_DEFINITION=pocdantic-runtime
VAULT_ADDR=
VAULT_NAMESPACE=
VAULT_TOKEN=
POCDANTIC_VAULT_AUDIENCE=
POCDANTIC_ACTOR_AUDIENCE=
POCDANTIC_VAULT_READ_PATH=database/creds/poc-readonly
POCDANTIC_DATABASE_HOST=
POCDANTIC_DATABASE_NAME=
POCDANTIC_DATABASE_PORT=5432

# CA file for the PostgreSQL TLS connection
POCDANTIC_DATABASE_SSLROOTCERT=

# Optional routing suffix for pooled connections, e.g. .PROJECT_REF
POCDANTIC_DATABASE_USERNAME_SUFFIX=
